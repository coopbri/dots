// icons can be searched at: https://www.nerdfonts.com/cheat-sheet
{
    // position Waybar at top layer
    "layer": "top",
    // Waybar position (top|bottom|left|right)
    // "position": "bottom",
    // Waybar height (remove for auto height)
    "height": 42,
    // Waybar width
    // "width": 1280,
    // Gaps between modules (4px)
    "spacing": 4,
    // Choose the order of the modules
    "modules-left": [
        "custom/logo",
        "hyprland/workspaces",
        // "sway/mode",
        // "sway/scratchpad",
        // "custom/media",
        "hyprland/window"
    ],
    // "modules-center": ["sway/window"],
    "modules-center": [
        "clock"
    ],
    // TODO get 'vpn' module working
    "modules-right": [
        "tray",
        // "mpd",
        "custom/spotify",
        // "custom/utc",
        // "idle_inhibitor",
        "pulseaudio",
        "network",
        // "vpn",
        "cpu",
        "memory",
        // "temperature",
        // TODO figure out why backlight not working (probs need install pkg)
        "backlight",
        // "keyboard-state",
        // "sway/language",
        "battery",
        // "battery#bat2",
        // "clock",
        "custom/power"
    ],
    // Modules configuration
    // "sway/workspaces": {
    //     "disable-scroll": true,
    //     "all-outputs": true,
    //     "warp-on-scroll": false,
    //     "format": "{name}: {icon}",
    //     "format-icons": {
    //         "1": "",
    //         "2": "",
    //         "3": "",
    //         "4": "",
    //         "5": "",
    //         "urgent": "",
    //         "focused": "",
    //         "default": ""
    //     }
