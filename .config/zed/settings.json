// Zed settings (https://zed.dev/docs/configuring-zed)
// TODO cyan highlight color
// TODO swap `CTRL` and `ALT` base
// TODO text wrap by default
// TODO disable middle click paste
{
  // "lsp": {
  // "biome": {
  //     "settings": {
  //       "require_config_file": true
  //     }
  //   }
  // },
  "languages": {
    "CSS": {
      "language_servers": ["tailwindcss-language-server"],
    },
    "Starlark": {
      "language_servers": ["tilt", "!starpls", "!buck2-lsp"],
    },
  },
  "format_on_save": "on",
  "code_actions_on_format": {
    "source.fixAll.biome": true,
    // "source.fixAll": true,
    // TODO doesn't seem to work
    // "source.organizeImports.biome": true,
  },
  // core
  "icon_theme": "Material Icon Theme",
  "agent": {
    "play_sound_when_agent_done": true,
    "default_profile": "write",
    "always_allow_tool_actions": true,
    "default_model": {
      "provider": "zed.dev",
      "model": "claude-sonnet-4",
    },
  },
  "project_panel": {
    "dock": "right",
  },
  "features": {
    "edit_prediction_provider": "zed",
  },
  "edit_predictions": {
    "mode": "subtle",
  },
  "soft_wrap": "editor_width",
  "theme": {
    "mode": "dark",
    "light": "Dracula",
    "dark": "Dracula Solid",
  },
  "vim_mode": false,
  "base_keymap": "Atom",
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "tabs": {
    "file_icons": true,
  },
  // TODO ligatures, only some render
  // UI font
  "ui_font_family": "FiraCode Nerd Font Mono",
  "ui_font_weight": 500,
  "ui_font_size": 15,
  // buffer font
  "buffer_font_family": "FiraCode Nerd Font Mono",
  "buffer_font_weight": 500,
  "buffer_font_size": 13,
  "experimental.theme_overrides": {
    "background.appearance": "blurred",
    // "background": "#282aa3650"
  },
  // "terminal": {
  // TODO cursor line
  // }
}
