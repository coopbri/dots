// Zed keymap overrides (https://zed.dev/docs/key-bindings)
[
  // TODO A and Shift+A in dock to create file/folder
  {
    "context": "Editor",
    "bindings": {
      // buffer navigation
      "ctrl-shift-tab": "pane::ActivatePreviousItem",
      "ctrl-tab": "pane::ActivateNextItem",
      // TODO https://github.com/zed-industries/zed/issues/8787
      // open definition
      // "alt-click": "editor::GoToDefinition"
      "ctrl-shift-x": "zed::Extensions",
      "ctrl-d": "editor::SelectNext",
      "alt-shift-l": "editor::SplitSelectionIntoLines",
    },
  },
  {
    "context": "Editor && mode == full",
    "bindings": {
      // newlines
      "ctrl-shift-enter": "editor::NewlineAbove",
      "ctrl-enter": "editor::NewlineBelow",
      // line movement
      "ctrl-up": "editor::MoveLineUp",
      "ctrl-down": "editor::MoveLineDown",
      "alt-z": "editor::ToggleSoftWrap",
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      // disable default copy keybind
      "ctrl-shift-c": null,
      // disable default paste keybind
      "ctrl-shift-v": null,
      "ctrl-v": "terminal::Paste",
      // tab navigation
      "ctrl-shift-t": "pane::ActivatePrevItem",
      "ctrl-t": "pane::ActivateNextItem",
    },
  },
  {
    "context": "Terminal && selection",
    "bindings": {
      // if selecting text, enable contextual keybind
      "ctrl-c": "terminal::Copy",
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-v": "terminal::Paste",
    },
  },

  {
    "context": "Workspace",
    "bindings": {
      "ctrl-\\": "workspace::ToggleLeftDock",
    },
  },
]
